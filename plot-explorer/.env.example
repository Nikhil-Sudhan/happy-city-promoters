# Optional browser key. Restrict it to your deployed domain / local preview URL.
# Never use an unrestricted server key here: VITE_ values are public client code.
VITE_GOOGLE_MAPS_API_KEY=
# Leave empty for automatic local / production links.
VITE_PORTFOLIO_URL=
# Production explorer path. Use / for a separate standalone deployment.
VITE_BASE_PATH=/plot-explorer/
